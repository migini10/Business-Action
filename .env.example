# ==========================================
# CONFIGURATION BASE DE DONNÉES (SUPABASE)
# ==========================================

# Copie ce fichier et renomme-le en ".env"
# Ensuite, remplace la valeur ci-dessous par celle de ton projet Supabase.

# Va dans Supabase > Project Settings > Database > Connection string > URI
# IMPORTANT : Décoche "Use connection pooling" pour obtenir le lien direct (port 5432)
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.mjdvoszkecoxpiwndvgv:[YOUR-PASSWORD]@aws-1-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.mjdvoszkecoxpiwndvgv:[YOUR-PASSWORD]@aws-1-eu-north-1.pooler.supabase.com:5432/postgres"

# Politique TLS du runtime applicatif (src/lib/prisma.ts / src/lib/database-ssl.ts).
# Valeurs acceptees : disable | require | verify-full
#   - absent ou valeur non reconnue => toujours verify-full (CA Supabase + validation stricte)
#   - disable      => aucun TLS (uniquement pour un Postgres local/prive, ex: Docker DigitalOcean
#                      sur reseau prive non expose a Internet)
#   - require      => TLS chiffre mais sans validation de certificat (reserve, non utilise)
#   - verify-full  => TLS strict avec CA Supabase pinnee (comportement Production, defaut)
# IMPORTANT : ceci NE controle PAS le TLS utilise par la CLI Prisma (migrate/studio/generate),
# qui lit uniquement le parametre sslmode=... eventuellement present dans DATABASE_URL/DIRECT_URL
# (mecanisme distinct). Le runtime applicatif retire automatiquement tout sslmode/sslcert/sslkey/
# sslrootcert de l'URL avant connexion, pour que cette variable ne puisse jamais etre contournee.
DATABASE_RUNTIME_SSL_MODE=verify-full

# ==========================================
# CONFIGURATION SUPABASE STORAGE
# ==========================================
# Nom du bucket Storage a utiliser. Aucun fallback silencieux vers le bucket
# Production n'existe dans le code : cette variable est obligatoire.
SUPABASE_STORAGE_BUCKET=dossier_documents_dev

# Doit valoir exactement "true" pour activer la suppression des fichiers
# orphelins par le cron cleanup. Laisser a "false" (ou absent) en dev/preview.
ENABLE_STORAGE_ORPHAN_CLEANUP=false

# ==========================================
# CONFIGURATION WHATSAPP CLOUD API (META)
# ==========================================
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
PASSWORD_RESET_OTP_SECRET=
RESEND_FROM_EMAIL=

RATE_LIMIT_SECRET=
