# ==========================================
# CONFIGURATION BASE DE DONNÉES (SUPABASE)
# ==========================================

# Copie ce fichier et renomme-le en ".env"
# Ensuite, remplace la valeur ci-dessous par celle de ton projet Supabase.

# Va dans Supabase > Project Settings > Database > Connection string > URI
# IMPORTANT : Décoche "Use connection pooling" pour obtenir le lien direct (port 5432)
DATABASE_URL="postgresql://postgres.[TON_PROJET]:[TON_MOT_DE_PASSE]@[REGION].pooler.supabase.com:5432/postgres"
