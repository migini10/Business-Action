// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  ADMIN
  AGENT
}

enum StatutDossier {
  EN_ATTENTE
  EN_TRAITEMENT
  OFFRE_ENVOYEE
  VALIDE
  REJETE
}

enum TypeVehicule {
  PARTICULIER
  UTILITAIRE
  POIDS_LOURD
  DEUX_ROUES
}

enum StatutPaiement {
  A_VENIR
  PAYE
  EN_RETARD
}

model User {
  id        String    @id @default(cuid())
  phone     String    @unique
  email     String?   @unique
  fullName  String?
  password  String
  role      Role      @default(CLIENT)
  dossiers     Dossier[]
  transactions Transaction[]
  passwordResetChallenges PasswordResetChallenge[]
  clientSessions ClientSession[]
  createdAt    DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AdminSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
}

model ClientSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
}


model Dossier {
  id            String        @id @default(cuid())
  numeroDossier String        @unique // Ex: DOS-1234-SN
  phone         String // Utilisé pour le suivi sans compte
  email         String?
  typeVehicule  TypeVehicule
  rectoUrl      String? // URL de la carte grise recto
  versoUrl      String? // URL de la carte grise verso
  devisUrl      String? // URL du devis envoyé au client
  statut        StatutDossier @default(EN_ATTENTE)

  // Relation optionnelle si l'utilisateur a un compte
  clientId String?
  client   User?   @relation(fields: [clientId], references: [id])

  echeances Echeance[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Echeance {
  id           String         @id @default(cuid())
  montant      Float
  dateEcheance DateTime
  statut       StatutPaiement @default(A_VENIR)
  description  String?

  dossierId String
  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TypeTransaction {
  PAIEMENT
  DETTE
  CREANCE
  REMBOURSEMENT
}

model Transaction {
  id          String          @id @default(cuid())
  montant     Float
  type        TypeTransaction
  description String
  commentaire String?
  statut                String          @default("Payé")
  date                  DateTime        @default(now())
  isModificationPending Boolean         @default(false)
  pendingModification   Json?

  clientId    String
  client      User            @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model PasswordResetChallenge {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash             String
  expiresAt           DateTime
  attempts            Int       @default(0)
  verifiedAt          DateTime?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  usedAt              DateTime?
  createdAt           DateTime  @default(now())

  @@index([userId])
}

enum WhatsAppBotState {
  IDLE
  QUOTE_VEHICLE
  QUOTE_CONFIRM
  TRACK_SELECT
}

model WhatsAppConversation {
  id            String            @id @default(cuid())
  waId          String            @unique
  displayName   String?
  lastMessageAt DateTime
  lastInboundAt DateTime?
  language      String?
  botState      WhatsAppBotState  @default(IDLE)
  draftQuote    Json?
  trackingContext Json?
  messages      WhatsAppMessage[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

enum WhatsAppMessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

model WhatsAppMessage {
  id             String                   @id @default(cuid())
  waMessageId    String?                  @unique
  direction      WhatsAppMessageDirection
  content        String                   @db.Text
  status         WhatsAppMessageStatus
  metaTimestamp  DateTime

  conversationId String
  conversation   WhatsAppConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  autoReplyToId  String?                  @unique

  createdAt      DateTime                 @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
